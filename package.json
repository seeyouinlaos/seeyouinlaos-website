{
  "name": "seeyouinlaos-website",
  "version": "1.0.0",
  "private": true,
  "description": "See You In Laos wedding website (static, served via Cloudflare Worker assets).",
  "main": "src/worker.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:rooms": "node src/build-rooms.cjs",
    "build:standalone": "node src/build-standalone.cjs",
    "edit": "node src/dev-editor-server.cjs",
    "test": "node --experimental-vm-modules --test 'test/registration.test.mjs' 'test/pricing.test.mjs' 'test/inventory.test.mjs' 'test/rooms.test.mjs' 'test/auth.test.mjs' 'test/guest-scope.test.mjs' 'test/flow.test.mjs' 'test/recompose.test.mjs' 'test/efg.test.mjs' 'test/guest-testing.test.mjs' 'test/experiences.test.mjs' 'test/seating-labels.test.mjs' 'test/eligibility.test.mjs' 'test/travelpass.test.mjs' 'test/release-auth.test.mjs' 'test/owner-patch-003.test.mjs' 'test/venue.test.mjs'",
    "deploy": "wrangler deploy",
    "release-check": "node src/release-check.cjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
