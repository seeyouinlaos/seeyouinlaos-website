{
  // Cloudflare Worker for the See You In Laos wedding website.
  // Static assets, the registration endpoint and the shared inventory ledger.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeyouinlaos-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the static site through the Worker's ASSETS binding.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // Durable registration store (HSW-001-ED-FER-001 §1): every successful
  // digital submission is persisted here BEFORE the guest sees RECEIVED.
  "kv_namespaces": [
    { "binding": "REG_KV", "id": "090270d0da434a8b8f49933cb604beb3" }
  ],

  // THE SHARED INVENTORY LEDGER. One Durable Object instance holds the stock of
  // every room category in every window. Cloudflare routes every request for
  // the id "ledger" to the same actor and runs them one at a time, which is
  // what makes a reservation atomic across guests, browsers and deployments.
  "durable_objects": {
    "bindings": [
      { "name": "INVENTORY", "class_name": "Inventory" },
      /* THE SEATING LEDGER (G): two independent chair inventories, ceremony
         and dinner, in ONE actor — a seat belongs to a named guest, holding a
         new chair always precedes releasing the old one. No geometry is coded;
         Guest Relations configures it through the protected route. */
      { "name": "SEATING", "class_name": "Seating" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Inventory"] },
    { "tag": "v2", "new_sqlite_classes": ["Seating"] }
  ],

  "observability": { "enabled": true }
}
