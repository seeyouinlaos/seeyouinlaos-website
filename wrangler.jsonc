{
  // Cloudflare Worker for the See You In Laos wedding website.
  // Static assets, the registration endpoint and the shared inventory ledger.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeyouinlaos-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the static site through the Worker's ASSETS binding.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // Durable registration store (HSW-001-ED-FER-001 §1): every successful
  // digital submission is persisted here BEFORE the guest sees RECEIVED.
  "kv_namespaces": [
    { "binding": "REG_KV", "id": "090270d0da434a8b8f49933cb604beb3" }
  ],

  // THE EMAILS (Owner, 16 Sep 2026): every stored journey notifies Guest Relations and the guest
  // through a real provider. The key is a Worker secret — `wrangler secret put BREVO_API_KEY`
  // (or RESEND_API_KEY); MAIL_FROM is the validated sender address of that provider account
  // (Brevo account of 16 Sep 2026: the sender validated there is the Owner's own address; replies go to Guest Relations).
  "vars": { "MAIL_FROM": "suthep.hrg@gmail.com" },

  /* THE DOCUMENT STORE (Owner, 21 Sep 2026 · OWNER-INFRA-CHANGE): ONE private R2
     bucket bound as DOCS — passports and flight documents, written by the guest
     they belong to, read only by Guest Relations through the Worker. No public
     access (no r2.dev URL, no custom domain), no other binding touched. */
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "siyl-docs" }
  ],
  /* THE DOCUMENT RETENTION CLOCK (Owner, 21 Sep 2026 · OWNER-INFRA-CHANGE): the one
     scheduled trigger of the one Worker, daily at 03:00 UTC. It does nothing before
     7 April 2027; from that date it purges the doc/ objects of DOCS and nothing else
     (src/worker.js · DOC_RETENTION · purgeDocuments). */
  "triggers": { "crons": ["0 3 * * *"] },

  // THE SHARED INVENTORY LEDGER. One Durable Object instance holds the stock of
  // every room category in every window. Cloudflare routes every request for
  // the id "ledger" to the same actor and runs them one at a time, which is
  // what makes a reservation atomic across guests, browsers and deployments.
  "durable_objects": {
    "bindings": [
      { "name": "INVENTORY", "class_name": "Inventory" },
      /* THE SEATING LEDGER (G): two independent chair inventories, ceremony
         and dinner, in ONE actor — a seat belongs to a named guest, holding a
         new chair always precedes releasing the old one. No geometry is coded;
         Guest Relations configures it through the protected route. */
      { "name": "SEATING", "class_name": "Seating" },
      /* THE ROOM OCCUPANCY ENGINE (Owner, 14 Sep 2026): persistent allocation
         units — ROOM A, B, C … — of two guest places each, joined and left by
         one guest at a time in their own name. The category ledger above stays
         bound for its history; the site no longer writes to it. */
      { "name": "ROOMS", "class_name": "Rooms" },
      /* THE JOURNEY DRAFT STORE (Owner, 17 Sep 2026 · P0): one actor per
         invitation — the revision comparison and the write are one serialised
         step, so a stale device or an overlapping autosave can never overwrite
         a removal. KV keeps a mirror for Guest Relations' listing. */
      { "name": "DRAFTS", "class_name": "Drafts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Inventory"] },
    { "tag": "v2", "new_sqlite_classes": ["Seating"] },
    { "tag": "v3", "new_sqlite_classes": ["Rooms"] },
    { "tag": "v4", "new_sqlite_classes": ["Drafts"] }
  ],

  "observability": { "enabled": true }
}
